NODE_ENV=development
API_PORT=3001
API_HOST=127.0.0.1
PUBLIC_API_BASE_URL="http://localhost:3001/api"
CORS_ALLOWED_ORIGINS="http://localhost:4173,http://localhost:5173"
VITE_API_BASE_URL="http://localhost:3001/api"
VITE_MP_WEIXIN_API_BASE_URL="http://127.0.0.1:3001/api"
VITE_PAYMENT_MODE="mock"
DATABASE_URL="postgresql://conference:conference_dev_password@localhost:5432/conference_dev?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="dev_jwt_secret_change_me"
# Use a different, stable secret in production so rotating JWT_SECRET does not invalidate encrypted admin configuration.
WECOM_CONFIG_ENCRYPTION_KEY="local_config_encryption_key_change_me"
# Optional comma-separated previous keys during a controlled encryption-key rotation.
WECOM_CONFIG_ENCRYPTION_KEY_PREVIOUS=""
USER_JWT_TTL_SECONDS=2592000
ADMIN_JWT_TTL_SECONDS=28800
ADMIN_DEFAULT_EMAIL="admin@example.com"
# Used only for first-time seeding. Leave empty after the initial admin is created.
ADMIN_BOOTSTRAP_PASSWORD=""
UPLOADS_DIR=""

# WeChat Mini Program login
# Keep mock for local H5 development. Set to real only in mp-weixin environments with real credentials.
WECHAT_LOGIN_MODE=mock
WECHAT_APP_ID="replace-with-your-wechat-app-id"
WECHAT_APP_SECRET="replace-with-your-wechat-app-secret"

# WeChat Pay
WECHAT_PAY_MODE=mock
WECHAT_PAY_ENABLED=false
WECHAT_PAY_MOCK=true
WECHAT_PAY_MCH_ID="replace-with-your-mch-id"
WECHAT_PAY_APP_ID=""
WECHAT_PAY_MCH_SERIAL_NO=""
WECHAT_PAY_API_V3_KEY="replace-with-your-api-v3-key"
WECHAT_PAY_PRIVATE_KEY_PATH="/path/to/apiclient_key.pem"
WECHAT_PAY_NOTIFY_URL="https://your-domain.com/api/payments/wechat/notify"
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=""
WECHAT_PAY_PLATFORM_PUBLIC_KEY_ID=""
# Use WECHAT_PAY_PLATFORM_CERT_SERIAL_NO instead when verifying with a platform certificate.
WECHAT_PAY_PLATFORM_CERT_SERIAL_NO=""
WECHAT_PAY_NOTIFY_TIMESTAMP_TOLERANCE_SECONDS=300


# Payment mode aliases used by docs and Codex prompts
PAYMENT_MODE=mock

# Notification center
NOTIFICATION_CENTER_ENABLED=false
WECHAT_SUBSCRIBE_MESSAGE_ENABLED=false
WECHAT_SUBSCRIBE_TEMPLATE_ID=""
WECHAT_SUBSCRIBE_TEMPLATE_REGISTRATION_SUCCESS=""
WECHAT_SUBSCRIBE_TEMPLATE_PAYMENT_SUCCESS=""
WECHAT_SUBSCRIBE_TEMPLATE_GUEST_SCHEDULE_UPDATED=""
WECHAT_SUBSCRIBE_TEMPLATE_REFUND_STATUS_UPDATED=""
WECHAT_MINIPROGRAM_STATE=trial
WECHAT_API_TIMEOUT_MS=8000
WECHAT_SUBSCRIBE_KEEP_ENABLED=false
NOTIFICATION_TASK_WORKER_ENABLED=true
SMS_ENABLED=false
SMS_PROVIDER=""
SMS_ACCESS_KEY_ID=""
SMS_ACCESS_KEY_SECRET=""
SMS_SIGN_NAME=""
SMS_TEMPLATE_REGISTRATION_SUCCESS=""

# Inventory alerts
INVENTORY_ALERT_ENABLED=false

# WeCom external customer group operations, official customer contact APIs only
WECOM_CUSTOMER_GROUP_ENABLED=false
WECOM_CORP_ID=""
WECOM_CUSTOMER_CONTACT_SECRET=""
WECOM_AGENT_ID=""

# Guest schedule sync with Enterprise WeChat SmartSheet
GUEST_SCHEDULE_SYNC_ENABLED=true
ORDER_EXPIRY_WORKER_ENABLED=true
ORDER_EXPIRY_SCAN_INTERVAL_MS=30000
ORDER_PAYMENT_CALLBACK_GRACE_MS=600000

# AI knowledge base
AI_KB_ENABLED=false
AI_PROVIDER=mock
AI_API_KEY=""
AI_MODEL=""
AI_BASE_URL=""

# Coupons and campaign QR claim
COUPON_CAMPAIGN_ENABLED=false

# Check-in
CHECKIN_ENABLED=false

# Refund and invoice
REFUND_ENABLED=false
REFUND_MODE=disabled
WECHAT_REFUND_ENABLED=false
REFUND_REQUIRES_APPROVAL=true
REFUND_DEADLINE_TEXT=""
REFUND_DESCRIPTION=""
INVOICE_ENABLED=false
WECHAT_PAY_REFUND_NOTIFY_URL=""

# Shop and finance reconciliation
SHOP_ENABLED=false
MALL_PAYMENT_MODE=disabled
WECHAT_PAY_MALL_NOTIFY_URL=""
MALL_MOCK_PAYMENT_ENABLED=false
MALL_REFUND_MODE=disabled
MALL_MOCK_REFUND_ENABLED=false
MALL_WECHAT_REFUND_ENABLED=false
MALL_REFUND_REQUIRES_APPROVAL=true
MALL_REFUND_DEADLINE_TEXT=""
MALL_REFUND_DESCRIPTION=""
OFFLINE_REFUND_MARK_ENABLED=false
FINANCE_RECONCILIATION_ENABLED=false
WECHAT_PAY_BILL_DOWNLOAD_ENABLED=false
WECHAT_PAY_BILL_STORAGE_PATH=""
